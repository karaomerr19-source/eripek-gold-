60000},\"is_device_based\":false,\"passed\":false},\"3365181325\":{\"name\":\"3365181325\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":55,\"id_type\":\"userID\",\"value\":{\"old_to_new_mapping\":{\"connector_0f9c9d4592e54d0a9a12b3f44a1e2010\":\"asdk_app_69a1d78e929881919bba0dbda1f6436d\",\"connector_14e85e16800b4e53bc6246019a83a307\":\"asdk_app_69b31dc2110c8191b8b47dc98fe5a052\",\"connector_2fc94c70cbb74b7caa6d07bf7231202e\":\"asdk_app_695bfc98071c8191bac7bc479aa27de7\",\"connector_6529c30f7e3590253d20626b8f971879\":\"connector_2a3c0c472f6f4238b47d41acfb317307\",\"connector_37316be7febe4224b3d31465bae4dbd7\":\"asdk_app_69c18c28f1188191bf5b8445c4ab0a2e\",\"connector_686fad9b54914a35b75be6d06a0f6f31\":\"asdk_app_69a089a326dc8191b32a3f2553f5be2c\",\"connector_6938a61c70f88191bbdca2dedb90d08b\":\"asdk_app_699d522f170c81919c824678c7c03732\",\"asdk_app_693ae33dd0f081918003ca256fe1126b\":\"asdk_app_697d413990c88191a2bf4799604f8f6c\",\"connector_2a3c0c472f6f4238b47d41acfb317307\":\"asdk_app_697acb8e53d88191bf7a79e62012ae14\"}},\"is_device_based\":false,\"passed\":false},\"208167308\":{\"name\":\"208167308\",\"rule_id\":\"6dhxyVTZ2QnuuwpxDwUiA8:100.00:25-6dhxyUeWAye0b6RC2oYFh6\",\"secondary_exposures\":[{\"gate\":\"2054053781\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"3737660407\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"3922602262\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"1326334369\",\"gateValue\":\"true\",\"ruleID\":\"6XNtx5BnDu95sYciBN1U9z:100.00:9\"},{\"gate\":\"957497898\",\"gateValue\":\"false\",\"ruleID\":\"Bg20Kw8ydPcademg0qKQq:5.00:1\"}],\"version\":424,\"id_type\":\"userID\",\"value\":{\"webhook_trigger_user_prompt_template\":\"{automation_prompt}\\n\\nThis run was triggered by a webhook event. Use the event below as the new information to evaluate for this run.\\nWebhook family: {family}\\nWebhook event:\\n{normalized_event_json}\",\"fiber_generic_chatgpt_builtin_tool_references\":[{\"tool_id\":\"automations\",\"tool_type\":\"ToolRef\"},{\"tool_type\":\"ToolRef\",\"tool_id\":\"image_gen\"}],\"additional_developer_message_prompt\":\"If you do not have an update for the user during this automation turn, you must emit `::SKIP_COMPLETION::`. UNLESS you have clarifying questions for the user that will help you perform your task - in which case, feel free to ask that question. \\n\\nExamples for when to output `::SKIP_COMPLETION::`:\\n- If the user asks you to let them know when a reservation opens up at Cotogna at a specific time, and you find out that there is still no reservation available\\n- If the user asks you to let them know when they have a new email but there are no new emails since your last run\",\"exact_schedule_proactive_start_offset_seconds\":10,\"automations_create_tool_additional_guidance\":\"Do NOT mention the automation id to the user in  your response.\",\"enable_browser_tool\":true,\"max_turns_per_conversation\":175,\"override_default_tools\":false,\"break_plugin_service_brte_history_chain\":true,\"fiber_use_generic_chatgpt_builtin_tools\":true,\"automations_list_limit\":100,\"condition_watch_jitter_radius_seconds\":600,\"personalized_task_card_read_timeout_seconds\":0.225,\"gaas_extra_features\":{\"multi_agent\":true,\"fast_mode\":true},\"enable_file_export\":true,\"automations_list_tool_additional_guidance\":\"The UI will already render the user's active automations from this list result. The automations will be rendered below your response Do NOT restate active automations in prose unless adding information not already visible to the user. Do not tell the user about any automations with enabled = false. They are considered deleted. You do not need to mention the UI either. Simply summarize in 1 sentence or less what automations exist.\\n\\nDo not call the automations `list` action again this turn; use the automations `peek` action for any further inspection.\",\"fiber_sync_suggestable_connectors_to_workspace\":false,\"general_agent_invoked_system_hints\":[],\"slack_webhook_bot_membership_message_template\":\"I couldn't create an immediate Slack monitor because @ChatGPT isn't in {channel}. I can still set up an hourly monitor right now, or you can install or reconnect the [ChatGPT Slack app](https://chatgpt.com/slack-ai-app-install), add @ChatGPT to the channel, and try again for immediate notifications. Which would you like?\",\"fiber_tool_call_elicitation_mode\":\"elicit_on_writes\",\"bypass_chat_model_output\":true,\"max_iterations_per_hour\":1,\"max_active_automations\":5,\"fiber_sync_hazelnut_skills_to_workspace\":false,\"model_lane_override\":\"auto\",\"private_peek_enabled\":true,\"automations_create_plan_tool_additional_guidance\":\"The user has created an automation for an ongoing goal with a private plan. Collaborate with the user across turns, use available structured context to understand their goals and prior progress, and help advance the saved plan.\",\"validate_automation_prompt_template\":\"\",\"tool_model_instructions\":\"\",\"skip_completion_text\":\"::SKIP_COMPLETION::\",\"active_task_limit_message_template\":\"You've reached your limit of {active_limit} active tasks. To schedule more tasks, consider pausing some tasks or upgrading your plan.\",\"exact_schedule_jitter_radius_seconds\":300,\"enable_whisper\":false,\"max_messages_per_conversation\":1000},\"is_device_based\":false,\"passed\":true},\"765440106\":{\"name\":\"765440106\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":13,\"id_type\":\"userID\",\"value\":{\"wallet_oaics_minimum_balance_minor_units\":0,\"cross_currency_wallet_warning\":{\"timeout_ms\":3000,\"enabled\":true},\"customer_balance_cache\":{\"read_timeout_ms\":500,\"write_timeout_ms\":500,\"enabled\":false}},\"is_device_based\":false,\"passed\":false},\"1977158438\":{\"name\":\"1977158438\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":4,\"id_type\":\"userID\",\"value\":{\"system_prompt\":\"The user is asking about an ad shown to them by {advertiser}. Your response must be about the ad shown. They are using the \\\"Ask ChatGPT\\\" feature to get ChatGPT's honest opinion on the product(s) in the advertisement, and in which situations it could be a great fit for them. You should be honest about when you think the product(s) would vs. would not be useful for the user, based on what you know about them.\\n\\nInformation about the ad:\\n{ad}.\\n\\nStructure your response in the following manner:\\n- Briefly describe the type of user, use case, or situation where this ad/product makes sense for the user.\\n- If appropriate, explain any mismatches with the user's stated preferences or goals. That is, where might it fall short for the user (if appropriate)? You don't have to do this for every query, but feel free to list limitations if you think they're pretty relevant.\\n- Give a concise recommendation (e.g., \\\"worth considering,\\\" \\\"probably not ideal,\\\" \\\"good budget option,\\\" \\\"seriously may be a fit,\\\" etc.)\\n\\nGuidelines:\\n- Be honest and practical.\\n- Do not blindly promote the ad.\\n- Avoid harsh or absolute negative language.\\n- Do not invent details not present in the ad.\\n- Focus on fit, not feature lists.\\n- If the mark on relevance is clearly missed, feel free to be funny with it and keep it lighthearted. Do not mock the user or advertiser; keep the humor gentle.\\n\\nKeep it concise, direct, and easy to scan.\\n\\n{conversation}\",\"enable_web_search\":false,\"user_prompt_key\":\"good_option\"},\"is_device_based\":false,\"passed\":false},\"2888003541\":{\"name\":\"2888003541\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":8,\"id_type\":\"userID\",\"value\":{\"max_bytes\":31457280},\"is_device_based\":false,\"passed\":false},\"2558204672\":{\"name\":\"2558204672\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":24,\"id_type\":\"userID\",\"value\":{\"check_paid_business_seat\":true,\"terms_url\":\"https://help.openai.com/en/articles/20001150\",\"check_workspace_business_free_trial\":true,\"run_grant_sentinel_check\":true,\"offer_text\":\"Get {amount} in credits for every member who starts using Codex.\",\"fine_print_text\":\"{amount} credit eligibility requires that the user be added as a Codex PAYG seat to a verified-domain organization and have used Codex on or before April 30, not have had a paid business seat within 90 days, not have redeemed the promotion before, not have been associated with a fraudulent organization, and be in a workspace with a total cap of no more than {maxAmount}.\",\"exclude_usage_based_seats_from_paid_business_seat_check\":true,\"max_total_credit_amount_usd\":500,\"per_eligible_invite_num_credits\":2500,\"check_fraudulent_organization\":true,\"terms_text\":\"View Terms\",\"check_workspace_owner\":true,\"check_max_workspace_redemption_count\":true,\"check_professional_workspace_owner_domain\":true,\"per_eligible_invite_credit_amount_usd\":100,\"max_workspace_member_count\":5,\"max_total_num_credits\":12500},\"is_device_based\":false,\"passed\":false},\"803147005\":{\"name\":\"803147005\",\"rule_id\":\"2jzbdp4GNAJq4v3miQ6fuC\",\"secondary_exposures\":[],\"version\":15,\"id_type\":\"userID\",\"value\":{\"batch_size\":25,\"variant\":\"control\"},\"is_device_based\":false,\"group_name\":\"Control\",\"is_experiment_active\":true,\"is_user_in_experiment\":true},\"4136699413\":{\"name\":\"4136699413\",\"rule_id\":\"layerAssignment\",\"secondary_exposures\":[],\"version\":20,\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"is_experiment_active\":true,\"is_user_in_experiment\":false},\"2850107578\":{\"name\":\"2850107578\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"3796009202\",\"gateValue\":\"true\",\"ruleID\":\"70knO3S2IIQ3C4K3vmxsog:100.00:1\"}],\"version\":55,\"id_type\":\"userID\",\"value\":{\"onboarding\":{\"impression_count\":5,\"screen_personalization_image_url\":\"https://cdn.openai.com/chatgpt/clients/bazaar/onboarding/pers