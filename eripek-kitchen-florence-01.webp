<ul data-start="74" data-end="142">
<li data-start="74" data-end="81" data-section-id="168osdl">
<p data-start="76" data-end="81"><code data-start="76" data-end="81">app</code></p>
</li>
<li data-start="82" data-end="89" data-section-id="168m8en">
<p data-start="84" data-end="89"><code data-start="84" data-end="89">lib</code></p>
</li>
<li data-start="90" data-end="106" data-section-id="1pzso84">
<p data-start="92" data-end="106"><code data-start="92" data-end="106">package.json</code></p>
