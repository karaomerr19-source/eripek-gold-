<li data-start="312" data-end="402" data-section-id="13cqhg0">
<p data-start="314" data-end="402"><span class="" data-state="closed"><button class="behavior-btn hover:entity-accent focus-visible:focus-ring entity-underline inline cursor-pointer appearance-none border-0 bg-transparent p-0 text-start align-baseline text-inherit" type="button"><strong data-start="315" data-end="350">eripek-kitchen-florence-01.webp</strong></button></span></p>
