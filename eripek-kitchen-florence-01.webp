<p data-start="2989" data-end="2995">Lavabo</p>
</li>
<li data-start="2996" data-end="3001" data-section-id="1o4cfk">
<p data-start="2998" data-end="3001">Niş</p>
</li>
<li data-start="3002" data-end="3010" data-section-id="5oocz1">
<p data-start="3004" data-end="3010">Tezgah</p>
</li>
<li data-start="3011" data-end="3025" data-section-id="1mwbqom">
