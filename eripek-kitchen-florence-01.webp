7890\",\"country\":\"AZ\",\"supported\":true,\"verifiable\":false,\"stripe_type\":\"az_tin\"},\"no_vat\":{\"country_label\":\"Norway\",\"verifiable\":false,\"country\":\"NO\",\"type\":\"no_vat\",\"reverse_charge\":true,\"region\":\"EEA-GB-CH\",\"placeholder\":\"123456789MVA\",\"description\":\"Norwegian VAT number\",\"stripe_type\":\"no_vat\",\"format\":\"[0-9]{9}MVA\",\"supported\":true},\"id_npwp\":{\"verifiable\":false,\"placeholder\":\"12.345.678.9-012.345\",\"region\":\"ID\",\"type\":\"id_npwp\",\"country_label\":\"Indonesia\",\"reverse_charge\":true,\"format\":\"([0-9]{2})\\\\.?([0-9]{3})\\\\.?([0-9]{3})\\\\.?([0-9])-?([0-9]{3})\\\\.?([0-9]{3})\",\"stripe_type\":\"id_npwp\",\"supported\":true,\"description\":\"Indonesian NPWP number\",\"replacement_string\":\"\\\\1.\\\\2.\\\\3.\\\\4-\\\\5.\\\\6\",\"country\":\"ID\"},\"ca_bn\":{\"supported\":true,\"description\":\"Canadian BN\",\"reverse_charge\":false,\"stripe_type\":\"ca_bn\",\"country\":\"CA\",\"format\":\"[0-9]{9}\",\"country_label\":\"Canada\",\"placeholder\":\"123456789\",\"verifiable\":false,\"type\":\"ca_bn\",\"region\":\"CA\"},\"hk_br\":{\"format\":\"[0-9]{8}\",\"placeholder\":\"12345678\",\"verifiable\":false,\"country\":\"HK\",\"country_label\":\"Hong Kong\",\"type\":\"hk_br\",\"stripe_type\":\"hk_br\",\"region\":\"HK\",\"description\":\"Hong Kong BR number\",\"supported\":false,\"reverse_charge\":false},\"gr_vat\":{\"country\":\"GR\",\"placeholder\":\"EL123456789\",\"stripe_type\":\"eu_vat\",\"type\":\"gr_vat\",\"verifiable\":true,\"country_label\":\"Greece\",\"reverse_charge\":true,\"supported\":true,\"format\":\"EL[0-9]{9}\",\"description\":\"European VAT number\",\"region\":\"EEA-GB-CH\"},\"fr_vat\":{\"country\":\"FR\",\"placeholder\":\"FRAB123456789\",\"verifiable\":true,\"supported\":true,\"country_label\":\"France\",\"type\":\"fr_vat\",\"format\":\"FR[A-Z0-9]{2}[0-9]{9}\",\"region\":\"EEA-GB-CH\",\"stripe_type\":\"eu_vat\",\"description\":\"European VAT number\",\"reverse_charge\":true},\"li_v