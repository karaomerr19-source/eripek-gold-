: none; --tg-layout-enter-duration: 300ms; --tg-layout-enter-delay: 0ms; --tg-layout-enter-timing-function: ease-in-out; --tg-layout-exit-duration: 300ms; --tg-layout-exit-delay: 0ms; --tg-layout-exit-timing-function: ease-in-out; --tg-layout-move-duration: 300ms; --tg-layout-move-delay: 0ms; --tg-layout-move-timing-function: var(--cubic-move);"><div class="fKQ0lq_TransitionItem"><div class="select-none active:select-auto data-has-range-start:select-auto"><button type="button" class="flex items-center gap-1 text-start select-none text-token-text-tertiary dark:text-(--interactive-label-tertiary-default) hover:text-token-text-primary dark:hover:text-token-text-primary" aria-expanded="false">7m 8s düşündü<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" data-rtl-flip="" class="icon-sm transition-transform"><use href="/cdn/assets/sprites-core-e289d166.svg#07889e" fill="currentColor"></use></svg></button><div class="fKQ0lq_Layout w-full" data-item-anchor="start" data-clip="true" data-dimension="height" style="--tg-will-change: auto; --tg-enter-opacity: 1; --tg-enter-transform: none; --tg-enter-filter: none; --tg-enter-duration: 300ms; --tg-enter-delay: 0ms; --tg-enter-timing-function: ease-in-out; --tg-exit-opacity: 0; --tg-exit-transform: none; --tg-exit-filter: none; --tg-exit-duration: 300ms; --tg-exit-delay: 0ms; --tg-exit-timing-function: ease-in-out; --tg-initial-opacity: 0; --tg-initial-transform: none; --tg-initial-filter: none; --tg-layout-enter-duration: 300ms; --tg-layout-enter-delay: 0ms; --tg-layout-enter-timing-function: ease-in-out; --tg-layout-exit-duration: 300ms; --tg-layout-exit-delay: 0ms; --tg-layout-exit-timing-function: ease-in-out; --tg-layout-move-duration: 300ms; --tg-layout-move-delay: 0ms; --tg-layout-move-timing-function: var(--cubic-move);"></div></div></div></div></div><div class="contents"><div class="contents"></div></div><div class="contents"><div class="contents"><div class="mt-1 flex flex-wrap gap-2 empty:hidden"></div></div></div><div class="contents"><div class="contents"></div></div><div class="contents"><div class="contents"></div></div><div class="contents"><div class="contents"></div></div><div class="contents"><div class="contents"></div></div><div class="contents"><div class="contents"></div></div><div class="contents"><div class="contents"></div></div><div class="contents"><div class="contents"><div class="mt-1 flex flex-wrap gap-2 empty:hidden"></div></div></div><div class="contents"><div class="contents"><div class="mt-1 flex flex-wrap gap-2 empty:hidden"></div></div></div><div class="contents"><div class="contents"></div></div><div class="contents"><div class="contents"><div class="mt-1 flex flex-wrap gap-2 empty:hidden"></div></div></div><div class="contents"><div class="contents"></div></div><div class="contents"><div class="contents"><div class="mt-1 flex flex-wrap gap-2 empty:hidden"></div></div></div><div class="contents"><div class="contents"><div class="mt-1 flex flex-wrap gap-2 empty:hidden"></div></div></div><div class="contents"><div class="contents"><div class="mt-1 flex flex-wrap gap-2 empty:hidden"></div></div></div><div class="contents"><div class="contents"></div></div><div class="contents"><div class="contents"><div class="mt-1 flex flex-wrap gap-2 empty:hidden"></div></div></div><div data-message-author-role="assistant" data-message-id="7d7f0c4b-0d70-41c8-bb55-77d030bbeaf8" dir="auto" data-message-model-slug="gpt-5-6-thinking" class="min-h-8 text-message relative flex w-full flex-col items-end gap-2 text-start break-words whitespace-normal outline-none keyboard-focused:focus-ring [.text-message+&amp;]:mt-1"><div class="flex w-full flex-col gap-1 empty:hidden"><div class="markdown prose dark:prose-invert wrap-break-word w-full dark markdown-new-styling"><p data-start="0" data-end="93">Evet tatlım, <strong data-start="13" data-end="44">bu ekran tam aradığımız şey</strong>. Vercel sana zaten ücretsiz kalıcı adres vermiş:</p>
<p data-start="95" data-end="123"><strong data-start="95" data-end="123"><code data-start="97" data-end="121">eripek-gold.vercel.app</code></strong></p>
<p data-start="125" data-end="167">Yani ayrıca domain satın almana gerek yok.</p>
<p data-start="169" data-end="454">Ben sistemi de istediğin düzene çevirdim: <strong data-start="211" data-end="300">tek ortak QR → Eripek Gold → Blok → Kat → Daire → Ad Soyad + Telefon → kişisel hesap.</strong> Daire bir kez farklı telefonla tanımlanınca ikinci kişi sahiplenemiyor, aynı cihaz müşteriyi hatırlıyor ve servis talebi gerçek ticket olarak kaydoluyor.</p>
<p data-start="456" data-end="526">Şimdi sadece yeni arayüzü GitHub’a yüklememiz kaldı. Son paket burada:</p>
<p data-start="528" data-end="619"><span class="" data-state="closed"><button class="behavior-btn hover:entity-accent focus-visible:focus-ring entity-underline inline cursor-pointer appearance-none border-0 bg-transparent p-0 text-start align-baseline text-inherit" type="button"><strong data-start="529" data-end="566">Eripek Gold – Tek QR Güncel Paket</strong></button></span></p>
<p data-start="621" data-end="694">Ve bundan sonra bütün lavabo/nişlere basacağımız <strong data-start="670" data-end="686">tek ortak QR</strong> burada:</p>
<p data-start="696" data-end="768"><button aria-label="Eripek Gold – Ortak QR" class="behavior-btn hover:entity-accent focus-visible:focus-ring entity-underline inline cursor-pointer appearance-none border-0 bg-transparent p-0 text-start align-baseline px-1 text-token-text-link font-medium" type="button"><span style="display: inline-block; height: 1lh; margin-inline-end: 3px; position: relative; vertical-align: bottom; width: 16px;"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" data-testid="library-file-icon" data-library-file-icon-kind="document" data-library-file-icon-key="photo" class="" style="color: rgb(255, 102, 173); height: 16px; position: absolute; top: 50%; transform: translateY(-50%); width: 16px;"><path fill-rule="evenodd" clip-rule="evenodd" d="M12.113 5.57446C13.4262 5.5745 14.491 6.63918 14.491 7.95239C14.4908 9.26547 13.4261 10.3303 12.113 10.3303C10.8 10.3302 9.73526 9.26544 9.73511 7.95239C9.73511 6.63922 10.7999 5.57455 12.113 5.57446ZM12.113 6.90454C11.5344 6.90463 11.0652 7.37375 11.0652 7.95239C11.0653 8.5309 11.5345 9.00015 12.113 9.00024C12.6916 9.0002 13.1607 8.53093 13.1609 7.95239C13.1609 7.37372 12.6917 6.90458 12.113 6.90454Z" fill="currentColor"></path><path fill-rule="evenodd" clip-rule="evenodd" d="M14.1667 2.52173C16.0068 2.52173 17.4988 4.01373 17.4988 5.85376V14.1868C17.4988 16.0268 16.0068 17.5188 14.1667 17.5188H5.83374C3.99371 17.5188 2.50171 16.0268 2.50171 14.1868V5.85376C2.50171 4.01373 3.99371 2.52173 5.83374 2.52173H14.1667ZM5.83374 3.85181C4.72825 3.85181 3.83179 4.74827 3.83179 5.85376V11.9524L5.05249 10.7317C5.96295 9.82123 7.43974 9.82144 8.35034 10.7317L13.8074 16.1887H14.1667C15.2722 16.1887 16.1687 15.2923 16.1687 14.1868V5.85376C16.1687 4.74827 15.2722 3.85181 14.1667 3.85181H5.83374ZM7.40991 11.6721C7.01871 11.2813 6.38399 11.2811 5.99292 11.6721L3.83179 13.8333V14.1868C3.83179 15.2923 4.72825 16.1887 5.83374 16.1887H11.9265L7.40991 11.6721Z" fill="currentColor"></path></svg></span><strong data-start="697" data-end="723">Eripek Gold – Ortak QR</strong></button></p>
<p data-start="770" data-end="1004">Şimdi ZIP’i indir → masaüstüne çıkar → GitHub <code data-start="816" data-end="829">eripek-gold</code> reposunda <strong data-start="840" data-end="872">Dosya ekle → Dosyaları yükle</strong> → içindeki <strong data-start="884" data-end="917"><code data-start="886" data-end="891">app</code> klasörünü klasör olarak</strong> ve <code data-start="921" data-end="935">package.json</code>, <code data-start="937" data-end="952">next-env.d.ts</code>, <code data-start="954" data-end="969">tsconfig.json</code> dosyalarını yükle → commit mesajı:</p>
<p data-start="1006" data-end="1036"><code data-start="1006" data-end="1036">Eripek Gold single QR portal</code></p>
<p data-start="1038" data-end="1078">Sonra Vercel otomatik yeniden dağıtacak.</p>
<p data-start="1080" data-end="1275" data-is-last-node="" data-is-only-node=""><strong data-start="1080" data-end="1110">QR’ı henüz toplu bastırma.</strong> Yeni dağıtım yeşil olduktan sonra telefondan bir kez beraber test edeceğiz; sonra aynı QR’dan istediğin kadar bastıracağız.  <span class="contents" data-content-reference-start="1275" data-content-reference-end="1275"><span class="align-middle" data-state="closed"><button aria-label="Kodlama Alıntısı" class="rounded-xl px-1 text-token-text-secondary bg-token-bg-tertiary hover:text-token-text-primary hover:bg-token-interactive-bg-secondary-selected"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon-sm"><use href="/cdn/assets/sprites-core-e289d166.svg#72c6a7" fill="currentColor"></use></svg></button></span></span></p></div></div></div><div class="w-full max-w-[480px]"><div class="border-token-border-default bg-token-bg-primary mb-2 overflow-hidden rounded-2xl border"><div id="_r_1t1_" class="divide-token-border-light flex flex-col divide-y"><div><div class="group/artifact-row hover:bg-token-bg-secondary/60 relative flex items-center"><button type="button" aria-label="eripek-gold-ortak-qr.png" class="group/open-file peer/open-file interactive-button interactive-label-primary focus-visible:ring-token-border-heavy flex min-w-0 flex-1 cursor-pointer items-center gap-3 bg-transparent py-3 ps-4 pe-14 text-start focus-visible:ring-1 focus-visible:outline-none focus-visible:ring-inset"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="size-6 shrink-0" style="color: rgb(255, 102, 173);"><path fill-rule="evenodd" clip-rule="evenodd" d="M12.113 5.57446C13.4262 5.5745 14.491 6.63918 14.491 7.95239C14.4908 9.26547 13.4261 10.3303 12.113 10.3303C10.8 10.3302 9.73526 9.26544 9.73511 7.95239C9.73511 6.63922 10.7999 5.57455 12.113 5.57446ZM12.113 6.90454C11.5344 6.90463 11.0652 7.37375 11.0652 7.95239C11.0653 8.5309 1